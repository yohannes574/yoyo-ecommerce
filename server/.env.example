PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/yoyo
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Public base URL of the STOREFRONT (used for payment callback links)
PUBLIC_BASE_URL=http://localhost:5173

# ── Email (SMTP) ────────────────────────────────────────────────
# Leave EMAIL_HOST empty for local dev: verification/reset codes print to the
# server console (a loud ⚠️ warning makes it obvious no real email goes out).
#
# To send REAL emails, pick one provider and fill in all four values:
#
# Gmail (free, easiest for testing):
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=yourstore@gmail.com
#   EMAIL_PASS=abcd efgh ijkl mnop   (16-char app password, spaces ok)
#
# Brevo (ex-Sendinblue, 300 emails/day free): https://brevo.com
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USER=your-brevo-login@example.com
#   EMAIL_PASS=your-brevo-smtp-key
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Yoyo <no-reply@yoyo.example>"

# ── Mobile money gateway (Phase 7) ──────────────────────────────
# Any Chapa-style aggregator works (Chapa, Santimpay, etc.).
# Leave empty to run in MOCK mode (a sandbox checkout page is used).
# Create a merchant account, then paste the keys here:
GATEWAY_BASE_URL=https://api.chapa.co/v1
GATEWAY_SECRET_KEY=
GATEWAY_PUBLIC_KEY=
# Secret used to verify the gateway webhook signature (HMAC-SHA256 of raw body)
GATEWAY_WEBHOOK_SECRET=
# Provider labels shown at checkout (comma separated)
GATEWAY_PROVIDER_NAMES=telebirr,cbebirr,mpesa
